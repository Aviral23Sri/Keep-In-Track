<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded body of the quick-save transaction notification.
     RemoteViews only allow basic widgets, so the grid is a fixed 3x3 set of
     TextView chips that QuickSaveNotifier fills, hides and pages through. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/step_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

    <TextView
        android:id="@+id/empty_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <LinearLayout
        android:id="@+id/row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/chip_0" style="@style/KitChip" />
        <TextView android:id="@+id/chip_1" style="@style/KitChip" />
        <TextView android:id="@+id/chip_2" style="@style/KitChip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/chip_3" style="@style/KitChip" />
        <TextView android:id="@+id/chip_4" style="@style/KitChip" />
        <TextView android:id="@+id/chip_5" style="@style/KitChip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/chip_6" style="@style/KitChip" />
        <TextView android:id="@+id/chip_7" style="@style/KitChip" />
        <TextView android:id="@+id/chip_8" style="@style/KitChip" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_back"
            style="@style/KitButtonSecondary"
            android:text="‹ Back" />

        <TextView
            android:id="@+id/btn_more"
            style="@style/KitButtonSecondary"
            android:text="More ›" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/kit_button_primary"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Save"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
